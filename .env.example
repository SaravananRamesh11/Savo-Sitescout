# Copy to .env (gitignored). Never commit real values.

# PostGIS-enabled Postgres connection string (read with os.getenv("db_url"); DATABASE_URL also accepted)
db_url=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Savomart internal Stores API (token is given in the hackathon brief; keep it here only)
SAVOMART_CRON_TOKEN=
# SAVOMART_STORES_URL=https://internal-service.savomart.in/bridge/api/store/list

# LLM (optional; without it the report uses a deterministic, number-safe template)
# LLM_PROVIDER: anthropic | openai (any OpenAI-compatible endpoint) | none
LLM_PROVIDER=none
LLM_API_KEY=
# LLM_MODEL=            # e.g. a current Gemini Flash model from AI Studio
# LLM_FALLBACK_MODELS=  # optional, comma separated: tried in order when LLM_MODEL is rate-limited or overloaded
# LLM_REASONING_EFFORT= # optional; defaults to 'none' for the Gemini endpoint
# LLM_BASE_URL=          # e.g. https://api.groq.com/openai/v1 or http://localhost:11434/v1 (Ollama)

# Optional tuning
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# MAX_AREA_KM2=60
# CORS_ORIGINS=http://localhost:5173

# Cloudflare R2 (property photos). Create an R2 API token with Object Read & Write scoped to ONE bucket.
# Keep the bucket private: the API serves photos through short-lived presigned URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_SIGNED_URL_TTL_S=3600
