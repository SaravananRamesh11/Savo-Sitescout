# Copy to .env.production (or set it in the Vercel project settings). Never commit real values.
#
# Public URL of the deployed backend, without a trailing slash. Leave EMPTY in development:
# the Vite dev server proxies /api to http://127.0.0.1:8000.
# Vite bakes this in at build time, so changing it on Vercel needs a redeploy.
VITE_API_BASE=https://your-backend.onrender.com
